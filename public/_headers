# Cabeceras para Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/cv/Miguel-Garcia-CV-EN.pdf
  Content-Disposition: attachment; filename="Miguel-Garcia-CV-EN.pdf"

/assets/cv/Miguel-Garcia-CV-ES.pdf
  Content-Disposition: attachment; filename="Miguel-Garcia-CV-ES.pdf"
